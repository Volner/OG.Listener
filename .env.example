# Frontend build setting. PUBLIC: use GitHub Actions repository Variables, not secrets.
# Required for GitHub Pages: external HTTPS API origin only, without /api or a path.
# VITE_API_BASE_URL=https://your-api.vercel.app
# Optional for local Pages build/preview in .env.pages.local; workflow sets this itself.
# VITE_BASE_PATH=/OG.Listener/

# Set in Vercel Production environment. Visitors need no installation or keys.
# Exact frontend origins allowed to access the API, comma-separated.
# GitHub project Pages uses https://username.github.io WITHOUT the /repository path.
# Use the actual custom-domain origin when applicable. Empty = same-origin only.
CORS_ORIGINS=

# Per-instance admission limits and an expiring per-IP token bucket.
# On Vercel these are not shared across instances and do not cap total usage.
API_MAX_ACTIVE=12
API_MAX_QUEUED=24
API_QUEUE_TIMEOUT_MS=5000
API_REQUESTS_PER_MINUTE=120
API_BURST=30
API_MAX_IP_ENTRIES=10000
API_IP_TTL_MS=600000

# Optional paid historical monthly listeners provider. Server environment only.
CHARTMETRIC_REFRESH_TOKEN=

# Optional full recordings from Jamendo. Audius works without an API key.
JAMENDO_CLIENT_ID=

# Optional Last.fm community tags. A visitor does not need a Last.fm account.
# Obtain the application's own key at https://www.last.fm/api/account/create
# Server only: never prefix this variable with VITE_.
LASTFM_API_KEY=

# Local npm start only. Vercel ignores these settings and invokes api/index.js.
HOST=127.0.0.1
PORT=3000
API_ONLY=false

# Local server proxy trust only: exact IP addresses or loopback; default none.
# A trusted proxy must overwrite X-Real-IP. X-Forwarded-For is ignored.
# Vercel uses its own validated platform client IP automatically.
TRUST_PROXY=none
